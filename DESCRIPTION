Package: learnr2
Title: Interactive Tutorials with 'Quarto' and 'WebR'
Version: 0.0.0.9002
Authors@R: c(
    person("David", "Kane", , "dave.kane@gmail.com", role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0002-6660-3934")),
    person("Minh", "Vu", , "minhvu0514@gmail.com", role = "aut")
